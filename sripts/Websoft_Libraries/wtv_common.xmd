<OnInit PROPERTY="1" EXPR="
	try
	{
		tools.update_commons_event_types( false, TopElem );
	}
	catch ( err )
	{
	}

	try
	{
		sBaseCommomUrl = 'x-local://wtv/wtv_common.xml';
		if ( TopElem.Doc.Url != sBaseCommomUrl )
		{
			sTenantName = '';
			teCommon = FetchDoc( sBaseCommomUrl ).TopElem;
			for ( fldListElem in teCommon )
			{
				arrElems = [];
				lngList = TopElem.Child( fldListElem.Name )
				for ( fldElem in fldListElem )
				{
					lngElem = lngList.GetOptChildByKey( fldElem.PrimaryKey );
					if ( lngElem != undefined )
					{
						for ( fldFieldElem in lngElem )
							if ( fldFieldElem.Title != '1' )
								fldFieldElem.AssignElem( fldElem.Child( fldFieldElem.Name ) );
					}
					else
					{
						_child = lngList.AddChild();
						_child.AssignElem( fldElem );
						arrElems.push( fldElem.PrimaryKey.Value );
					}
				}
				if ( LdsIsServer &amp;&amp; ArrayCount( arrElems ) != 0 )
				{
					if ( LdsIsServer )
						alert( 'Common list &quot;' + TopElem.Doc.Url + '&quot; list &quot;' + fldListElem.Name + '&quot; obtained elements: &quot;' + ArrayMerge( arrElems, 'This', '&quot;, &quot;' ) + '&quot;.' );
				}
			}
		}
	}
	catch ( err )
	{
		alert( 'Common OnInit error: ' + err );
	}
"/>

</SPXML-FORM>